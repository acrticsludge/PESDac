---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import AuthLayout from "../components/auth/AuthLayout";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Log in — PESDac</title>
    <ClientRouter />
    <style is:inline>
      html { color-scheme: dark; }
      :root { --color-accent: #ebebeb; --color-accent-muted: #262626; --color-on-accent: #171717; --color-neutral: #FFFFFF1A; --color-background-surface: #262626; --color-background-body: #1b1b1b; --color-background-muted: #1b1b1b; --color-text-primary: #fafafa; --color-text-secondary: #a3a3a3; --color-text-disabled: #525252; --color-text-accent: #ebebeb; --color-icon-accent: #ebebeb; --color-icon-primary: #fafafa; --color-icon-secondary: #a3a3a3; --color-icon-disabled: #525252; --color-background-card: #1b1b1b; --color-background-popover: #1b1b1b; --color-success: #9fe59b; --color-success-muted: #84c9803D; --color-on-success: #171717; --color-error: #ffc6c1; --color-error-muted: #ff9e973D; --color-on-error: #171717; --color-warning: #fdcf4f; --color-warning-muted: #deb4333D; --color-on-warning: #171717; --color-border: #FFFFFF1A; --color-border-emphasized: #525252; --color-skeleton: #525252; --color-shadow: #0000004D; --color-background-blue: #9eb7ff3D; --color-border-blue: #6d9cfe; --color-icon-blue: #9eb7ff; --color-text-blue: #c7d3ff; --color-background-cyan: #83c2d43D; --color-border-cyan: #67a7b8; --color-icon-cyan: #83c2d4; --color-text-cyan: #9edef0; --color-background-gray: #262626; --color-border-gray: #262626; --color-icon-gray: #a3a3a3; --color-text-gray: #e5e5e5; --color-background-green: #84c9803D; --color-border-green: #69ad67; --color-icon-green: #84c980; --color-text-green: #9fe59b; --color-background-orange: #ffa2583D; --color-border-orange: #e2883e; --color-icon-orange: #ffa258; --color-text-orange: #ffc9a2; --color-background-pink: #ff99c33D; --color-border-pink: #f273aa; --color-icon-pink: #ff99c3; --color-text-pink: #ffc3da; --color-background-purple: #f297ff3D; --color-border-purple: #dd74f0; --color-icon-purple: #f297ff; --color-text-purple: #fac1ff; --color-background-red: #ff9e973D; --color-border-red: #ff6f6c; --color-icon-red: #ff9e97; --color-text-red: #ffc6c1; --color-background-teal: #7ec6b83D; --color-border-teal: #63ab9d; --color-icon-teal: #7ec6b8; --color-text-teal: #a3e5d4; }
      html, body { background-color: #1b1b1b !important; color: #fafafa !important; font-family: Figtree, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important; color-scheme: dark !important; }
    </style>
  </head>

  <body>
    <AuthLayout
      client:load
      pathname="sign-in"
      title="Welcome back"
      subtitle="Log in to your PESDac account"
      swapHref="/signup"
      swapLabel="Don't have an account?"
    />
  </body>
</html>
