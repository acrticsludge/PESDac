        </section>

        <section>
          <h2 class="bd-h2">Option D — Signal field</h2>
          <p class="bd-sub">Fading dot grid with one sweeping signal curve. Nods to packets on a wire; busiest of the four, still monochrome.</p>
          <div class="bd-scene">
            <svg viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <pattern id="bdD-dots" width="18" height="18" patternUnits="userSpaceOnUse">
                  <circle cx="2.5" cy="2.5" r="1.6" fill="#ffffff" />
                </pattern>
                <radialGradient id="bdD-mask" cx="0.5" cy="0.62" r="0.65">
