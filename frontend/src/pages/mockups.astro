---
import "../styles/global.css";
import ThreadLoaderMockups from "../components/chat/ThreadLoaderMockups";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>PESDac — Thread loader mockups</title>
    <style is:inline>
      html { color-scheme: dark; }
      :root {
        --color-background-body: #1b1b1b;
      }
      html, body {
        background-color: #1b1b1b !important;
        color: #fafafa !important;
        font-family: Figtree, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif !important;
        color-scheme: dark !important;
        margin: 0;
        padding: 0;
      }
    </style>
  </head>

  <body>
    <div style="display: flex; flex-direction: column; gap: 1.5rem; padding: 2.5rem 1.5rem 4rem;">
      <div style="max-width: 720px; margin-inline: auto; width: 100%;">
        <a href="/new" style="color: #a3a3a3; text-decoration: none; font-size: 0.875rem;">← Back to /new</a>
      </div>
      <ThreadLoaderMockups client:load />
      <div style="max-width: 720px; margin-inline: auto; width: 100%; display: flex; flex-direction: column; gap: 2rem; margin-top: 1rem;">
        <div>
          <h1 class="bd-h1">Composer backdrop mockups</h1>
          <p class="bd-sub">Static mocks for the plain-grey zone behind the chat composer — layered white/grey SVG washes on the existing dark dock. Pick one and it gets wired into the real dock.</p>
        </div>

        <section>
          <h2 class="bd-h2">Option A — Contour drift</h2>
          <p class="bd-sub">Topographic contour lines + a soft glow, top-left. Studious, quiet; reads as "maps" without stealing focus.</p>
          <div class="bd-scene">
            <svg viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <radialGradient id="bdA-glow" cx="0.22" cy="0.18" r="0.55">
                  <stop offset="0" stop-color="#ffffff" stop-opacity="0.12" />
                  <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
                </radialGradient>
              </defs>
              <rect width="800" height="320" fill="url(#bdA-glow)" />
              <g fill="none" stroke="#ffffff" stroke-width="1.5">
                <path d="M-40,250 C120,210 180,260 320,225 S560,160 840,195" opacity="0.10" />
                <path d="M-40,275 C130,235 200,285 340,250 S580,185 840,220" opacity="0.08" />
                <path d="M-40,300 C140,260 220,310 360,275 S600,210 840,245" opacity="0.06" />
                <path d="M-40,225 C110,185 170,235 310,200 S550,135 840,170" opacity="0.07" />
                <path d="M-40,200 C100,160 160,210 300,175 S540,110 840,145" opacity="0.05" />
                <path d="M560,320 C590,250 660,230 700,160 S760,60 840,40" opacity="0.06" />
                <path d="M600,320 C625,260 685,245 720,180 S775,85 840,65" opacity="0.05" />
              </g>
            </svg>
            <div class="bd-thread">
              <div class="bd-user">Walk me through it step by step</div>
              <div class="bd-ai"><strong>Full walkthrough.</strong> Work it end to end, one step at a time, checking each step against those definitions.</div>
            </div>
            <div class="bd-composer">
              <div class="bd-tools"><span>⌕</span><span>⎘</span><span>@</span><span>⋯</span></div>
              <div class="bd-input">Ask anything about CN…</div>
              <div class="bd-foot"><span class="bd-auto">Auto ▾</span><span class="bd-right"><span class="bd-mic">🎙</span><span class="bd-send">↑</span></span></div>
            </div>
          </div>
        </section>

        <section>
          <h2 class="bd-h2">Option B — Aurora wash</h2>
          <p class="bd-sub">Two blurred light bands settling behind the composer, like light spilling onto a desk. Warmest of the four.</p>
          <div class="bd-scene">
            <svg viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <defs>
                <filter id="bdB-blur" x="-60%" y="-60%" width="220%" height="220%">
                  <feGaussianBlur stdDeviation="55" />
                </filter>
                <linearGradient id="bdB-fade" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#ffffff" stop-opacity="0.10" />
                  <stop offset="1" stop-color="#ffffff" stop-opacity="0" />
                </linearGradient>
              </defs>
              <rect width="800" height="150" fill="url(#bdB-fade)" />
              <g filter="url(#bdB-blur)">
                <ellipse cx="250" cy="235" rx="220" ry="70" fill="#ffffff" opacity="0.13" />
                <ellipse cx="580" cy="265" rx="260" ry="60" fill="#8f8f8f" opacity="0.16" />
                <ellipse cx="430" cy="180" rx="150" ry="45" fill="#ffffff" opacity="0.06" />
              </g>
              <rect y="0" width="800" height="1.5" fill="#ffffff" opacity="0.10" />
            </svg>
            <div class="bd-thread">
              <div class="bd-user">Walk me through it step by step</div>
              <div class="bd-ai"><strong>Full walkthrough.</strong> Work it end to end, one step at a time, checking each step against those definitions.</div>
            </div>
            <div class="bd-composer">
              <div class="bd-tools"><span>⌕</span><span>⎘</span><span>@</span><span>⋯</span></div>
              <div class="bd-input">Ask anything about CN…</div>
              <div class="bd-foot"><span class="bd-auto">Auto ▾</span><span class="bd-right"><span class="bd-mic">🎙</span><span class="bd-send">↑</span></span></div>
            </div>
          </div>
        </section>

        <section>
          <h2 class="bd-h2">Option C — Strata</h2>
          <p class="bd-sub">Diagonal layered bands with hairline highlight edges. Most geometric — echoes packet layers / OSI stacks.</p>
          <div class="bd-scene">
            <svg viewBox="0 0 800 320" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
              <g transform="rotate(-8 400 160)">
