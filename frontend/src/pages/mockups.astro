                </mask>
              </defs>
              <rect width="800" height="320" fill="url(#bdD-dots)" opacity="0.13" mask="url(#bdD-fade)" />
              <path d="M-40,270 C150,270 180,150 340,150 S520,240 680,190 S780,120 850,130" fill="none" stroke="#ffffff" stroke-width="2" opacity="0.28" />
              <path d="M-40,288 C160,288 200,175 350,175 S530,258 685,210 S785,145 850,155" fill="none" stroke="#ffffff" stroke-width="1.5" opacity="0.10" />
              <circle cx="680" cy="190" r="4" fill="#ffffff" opacity="0.5" />
