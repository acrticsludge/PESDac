# Mirror of the repo-root .env server vars + the PUBLIC_* client vars.
# Copy to .env and fill in (never commit .env).
# PUBLIC_* vars are exposed to the browser; the rest are server-only.

# Host only — lib/auth.ts appends /api/v1 to every path.
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_BETTER_AUTH_URL=http://localhost:4321

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
