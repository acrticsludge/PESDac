# Mirror of the repo-root .env server vars + the PUBLIC_* client vars.
# Copy to .env and fill in (never commit .env).
# PUBLIC_* vars are exposed to the browser; the rest are server-only.

# Host only — lib/auth.ts appends /api/v1 to every path.
PUBLIC_API_BASE_URL=http://localhost:8000
PUBLIC_BETTER_AUTH_URL=http://localhost:4321

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4321
# Every origin that serves the app in a browser (dev :4321 is covered
# by the base URL; the :4323 preview/test server is not — without it
# all browser sign-up/sign-in POSTs 403 INVALID_ORIGIN).
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321,http://localhost:4323
BETTER_AUTH_TRUSTED_PROXIES=
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
