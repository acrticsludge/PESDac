# Copy to backend/.env (never commit .env).

# Neon Postgres (database-only) — direct URL for migrations and app traffic.
DATABASE_URL=postgresql+psycopg://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# BetterAuth
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=your-32-char-secret-here
# Exact origins allowed for Better Auth callbacks and browser requests.
# Keep this aligned with every frontend origin; do not use *.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321
# Optional proxy IPs/CIDRs that are allowed to supply forwarded client IPs.
BETTER_AUTH_TRUSTED_PROXIES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser origin(s) allowed to call our API. CORS preflight + credentialed
# requests both need the exact origin string. List EVERY origin that serves
# the frontend (dev port, preview URLs, prod domain) — any mutation
# (PATCH/DELETE/POST) from an unlisted origin is rejected with 403
# "Origin not allowed", which surfaces in the UI as a save failure.
FRONTEND_ORIGINS=http://localhost:4321

# Must be true when any FRONTEND_ORIGINS entry uses https://. Dev can be false.
COOKIE_SECURE=false

ENV=dev
