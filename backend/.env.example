# Copy to backend/.env (never commit .env).

# Neon Postgres (database-only) — direct URL for migrations and app traffic.
DATABASE_URL=postgresql+psycopg://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# BetterAuth
BETTER_AUTH_URL=http://localhost:4321
BETTER_AUTH_SECRET=your-32-char-secret-here
# Exact origins allowed for Better Auth callbacks and browser requests.
# Keep this aligned with every frontend origin; do not use *.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:4321
# Optional proxy IPs/CIDRs that are allowed to supply forwarded client IPs.
BETTER_AUTH_TRUSTED_PROXIES=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Browser origin(s) allowed to call our API. CORS preflight + credentialed
# requests both need the exact origin string. List EVERY origin that serves
# the frontend (dev port, preview URLs, prod domain) — any mutation
# (PATCH/DELETE/POST) from an unlisted origin is rejected with 403
# "Origin not allowed", which surfaces in the UI as a save failure.
FRONTEND_ORIGINS=http://localhost:4321

# Must be true when any FRONTEND_ORIGINS entry uses https://. Dev can be false.
COOKIE_SECURE=false

# Upstash Redis REST (read-through cache). Optional — unset ⇒ NullCache
# (DB path, zero behavior delta). Values from the Upstash Connect panel;
# names only here, never values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# LLM BYOK encryption (Fernet key for the llm_credentials table).
# Optional in dev/test — unset ⇒ /llm/* answers 503. REQUIRED in prod.
# Mint: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Name only here, never the value. Rotation orphans stored keys (users re-save).
LLM_KEY_ENCRYPTION_KEY=

# Retrieval P1 (spec retrieval-phase1 §7) — all optional, names only.
# Unset ⇒ hash/local provider paths or 503/502 displayable errors, never boot failure.
RETRIEVAL_EMBED_PROVIDER=
CF_ACCOUNT_ID=
CF_API_TOKEN=
NVIDIA_API_BASE=
NVIDIA_API_KEY=
CF_ENRICH_ACCOUNT_ID=
CF_ENRICH_API_TOKEN=
CURATOR_AUTH_IDS=
R2_PUBLIC_BASE=
RETRIEVAL_TOPK=
RETRIEVAL_MAX_CHARS=
RRF_K=
# Reserved for the later rerank phase: backend env only, never frontend,
# never the repo — P1 code paths must not read it.
TYPESAFE_API_KEY=

ENV=dev
