# Copy to backend/.env (never commit .env). See architecture doc §6 + auth spec v6.

# Neon Postgres — direct URL for migrations, pooled URL for app traffic.
DATABASE_URL=postgresql+psycopg://neondb_owner:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_POOLED=postgresql+psycopg://neondb_owner:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Auth — sign-in for your app. JWKS is at
# ${NEON_AUTH_BASE_URL}/.well-known/jwks.json
NEON_AUTH_BASE_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth
NEON_AUTH_JWKS_URL=https://ep-xxx.neonauth.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json

# Browser origin(s) allowed to call our API. CORS preflight + credentialed
# requests both need the exact origin string.
FRONTEND_ORIGINS=http://localhost:4321

# Must be true when any FRONTEND_ORIGINS entry uses https://. Dev can be false.
COOKIE_SECURE=false

# Rate limits (per IP per window). Auth-class rate limiting is Neon-owned.
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SIGNUP=5

ENV=dev
