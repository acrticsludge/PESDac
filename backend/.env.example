# Copy to backend/.env (never commit .env). See architecture doc §6.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pesdac
JWT_SECRET=replace-with-32-plus-byte-random-secret
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
FRONTEND_ORIGINS=http://localhost:4321
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
RESEND_API_KEY=
RESET_MAIL_FROM=noreply@example.com
RATE_LIMIT_LOGIN=10
RATE_LIMIT_SIGNUP=5
ENV=dev
